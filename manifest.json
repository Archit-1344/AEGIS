{
  "manifest_version": 3,
  "name": "A.E.G.I.S.",
  "version": "0.30.0",
  "description": "A.E.G.I.S. \u2013 Anti-Phishing Email Gateway & Intelligence System. Client-side, privacy-preserving anti-phishing membrane pipeline for Gmail and Outlook Web.",
  "key": "",
  "permissions": ["storage", "alarms", "activeTab", "identity"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://gmail.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://cloudflare-dns.com/*",
    "https://rdap.org/*"
  ],
  "oauth2": {
    "client_id": "134567477332-ft2r5f12rc6rvgkgqg6st3k7tdhnmc9m.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.metadata"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["lib/levenshtein.js", "lib/uts39-data.js", "lib/confusables.js", "lib/senderIdentity.js", "lib/attachmentAnalysis.js", "lib/trustScore.js", "content.js"],
      "css": ["styles/banner.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "A.E.G.I.S."
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
